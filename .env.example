# Nusxa oling: cp .env.example .env  — va qiymatlarni o'zgartiring

# Yangi kalit yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing
DEBUG=False
ALLOWED_HOSTS=jurnal.uz,www.jurnal.uz,127.0.0.1,localhost
